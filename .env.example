# Copy to .env (never commit .env). Every variable is optional: defaults run the
# full local pipeline (llama.cpp + Qwen2.5-3B + prompt v3 + bge-small + reranker).
# Variables are read from the process environment; no code loads .env, so export
# them first: `set -a; source .env; set +a` (shell) or `docker run --env-file .env`.

# --- Data / index ---
AIACT_SOURCE_PATH=data/raw/ai_act_32024R1689_en.xhtml
AIACT_INDEX_DIR=data/index
AIACT_CHUNK_WORDS=150

# --- Retrieval ---
AIACT_EMBEDDING_MODEL=models/bge-small-en-v1.5
# Empty string disables the cross-encoder reranker.
AIACT_RERANKER_MODEL=models/ms-marco-MiniLM-L-6-v2
# dense | bm25 | hybrid
AIACT_RETRIEVAL_MODE=hybrid
AIACT_TOP_K=5

# --- Generation ---
# llama_cpp | ollama | openai
AIACT_LLM_PROVIDER=llama_cpp
# Default: Qwen2.5-3B-Instruct Q4_K_M (with prompt v3: p50 19.4 s on 4 CPU cores).
# Fast option: models/qwen2.5-1.5b-instruct-q4_k_m.gguf (p50 13.9 s; gets only half of
# the out-of-scope questions right). Both are fetched by scripts/download_models.py.
AIACT_LLM_MODEL=models/qwen2.5-3b-instruct-q4_k_m.gguf
AIACT_LLM_CTX=4096
# 0 = llama.cpp default
AIACT_LLM_THREADS=0
# Prompt file prompts/answer_<version>.txt: v1 | v2 | v3 (default v3).
AIACT_PROMPT_VERSION=v3
AIACT_PROMPTS_DIR=prompts
# Generation budget in tokens (answers cut by it fail JSON validation: parse_error).
AIACT_MAX_TOKENS=384
# Translate non-English questions to English with the LLM before retrieval (1 | 0).
AIACT_TRANSLATE_QUERIES=1
AIACT_SEED=42

# Ollama (e.g. AIACT_LLM_PROVIDER=ollama, AIACT_LLM_MODEL=qwen2.5:3b)
AIACT_OLLAMA_URL=http://localhost:11434

# OpenAI-compatible API with a free tier (e.g. Groq). Key only via environment.
AIACT_OPENAI_BASE_URL=https://api.groq.com/openai/v1
AIACT_OPENAI_API_KEY=
